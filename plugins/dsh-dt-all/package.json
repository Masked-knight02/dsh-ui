{
  "name": "@masked-knight02/dsh-client-ui-dt-all",
  "description": "dsh-dt-ui 全家桶聚合插件：一键安装全部功能插件（status / pet / git / run / ssh / board / stats / remote / panel / skins），作为 dsh profile bundle",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "prepare": "tsdown --config tsdown.prepare.config.ts"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map",
    "src",
    "cordis.patch.yml"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@masked-knight02/dsh-client-ui-dt-board": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-git": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-panel": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-pet": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-remote": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-run": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-skins": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-ssh": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-stats": "^0.1.0",
    "@masked-knight02/dsh-client-ui-dt-status": "^0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.20.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
